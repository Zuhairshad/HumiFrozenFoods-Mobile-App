# Copy to .env for local development. NEVER commit real values.
# Names only; every value below is a placeholder.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=humis

# Comma-separated exact origins (scheme://host[:port], no trailing slash). Empty = deny all browsers.
ALLOWED_ORIGINS=http://localhost:8081

# Public base URL of this API (required in production)
PUBLIC_API_BASE=http://localhost:3000

# Stripe (required in production)
STRIPE_SECRET_KEY=sk_test_<placeholder>
STRIPE_WEBHOOK_SECRET=whsec_<placeholder>

# Guest order tokens: "kid:base64url-key[,kid2:base64url-key]"; first entry signs, all verify.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_KEYS=k1:<base64url-32-bytes>
GUEST_TOKEN_TTL_SECONDS=1209600

# Which header carries the real client IP behind a trusted proxy (e.g. x-real-ip on Vercel). Unset = socket address.
TRUSTED_IP_HEADER=

# Tunables (defaults shown)
BODY_LIMIT_BYTES=102400
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
