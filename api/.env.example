# Copy to .env for local development. NEVER commit real values.
# Names only; every value below is a placeholder.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=humis

# Comma-separated exact origins (scheme://host[:port], no trailing slash). Empty = deny all browsers.
ALLOWED_ORIGINS=http://localhost:8081

# Public base URL of this API (required in production)
PUBLIC_API_BASE=http://localhost:3000

# Stripe (required in production)
STRIPE_SECRET_KEY=sk_test_<placeholder>
STRIPE_WEBHOOK_SECRET=whsec_<placeholder>

# Guest order tokens: "kid:base64url-key[,kid2:base64url-key]"; first entry signs, all verify.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_KEYS=k1:<base64url-32-bytes>
GUEST_TOKEN_TTL_SECONDS=1209600

# Which header carries the real client IP behind a trusted proxy (e.g. x-real-ip on Vercel). Unset = socket address.
TRUSTED_IP_HEADER=

# Tunables (defaults shown)
BODY_LIMIT_BYTES=102400
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Business rules (docs/api-contract.md section 5) ---
# Existing collections in the owner's database. Change only if they are named differently.
ORDERS_COLLECTION=orders
PRODUCTS_COLLECTION=products
# Delivery fee in pence. 799 and 5000 are the values in the live site settings (codDeliveryCharge / codFreeDeliveryThreshold).
# The homepage banner says "free over 25 pounds" instead: CONFIRM which is right. Empty threshold = delivery never free.
DELIVERY_FEE_PENCE=799
FREE_DELIVERY_THRESHOLD_PENCE=5000
MIN_ORDER_PENCE=0
# JSON array. Empty = no promo codes (the app hides the promo field). Example:
# PROMO_CODES=[{"code":"HUMI15","kind":"percentage","value":15}]
PROMO_CODES=[]
# order_status written when a payment succeeds. Default leaves the order pending for staff to process.
PAID_ORDER_STATUS=order-pending
ORDER_NUMBER_DIGITS=12
PENDING_ORDER_TTL_MINUTES=120
LOW_STOCK_THRESHOLD=5
