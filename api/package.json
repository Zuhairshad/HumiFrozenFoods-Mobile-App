{
  "name": "humis-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/ensure-indexes.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@vercel/functions": "^3.10.3",
    "hono": "^4.13.13",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
