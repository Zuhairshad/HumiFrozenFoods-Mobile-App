{
  "expo": {
    "name": "Humi's Frozen Foods",
    "slug": "humi-frozen-foods",
    "scheme": "humi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08302F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.humisfrozenfoods.app"
    },
    "android": {
      "package": "com.humisfrozenfoods.app",
      "adaptiveIcon": {
        "backgroundColor": "#08302F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#08302F",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.humisfrozenfoods.app",
          "enableGooglePay": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
