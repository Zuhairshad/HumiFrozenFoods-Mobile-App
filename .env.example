# Copy to `.env.local` for local development (`.env*.local` is git-ignored). Never commit real values.
#
# IMPORTANT: every EXPO_PUBLIC_* variable is inlined into the JavaScript bundle at build time and
# shipped to every user's device (and to the web export). Anyone can read them. They are PUBLIC.
# NEVER put a secret here: no Stripe secret key (sk_...), no webhook secret (whsec_...),
# no MongoDB URI, no guest-token keys. Those belong only in the API's environment (api/.env.example).

# Base URL of the Humi API (no trailing slash, no /v1). Examples:
#   local device on the same Wi-Fi:  http://192.168.1.50:3000   (use your computer's LAN IP, not localhost)
#   production:                      https://<your-api-host>
# Leave empty/unset to run in demo mode (bundled catalogue and a mock checkout, clearly labelled in the app).
EXPO_PUBLIC_API_BASE_URL=

# Stripe PUBLISHABLE key (pk_test_... in test mode, pk_live_... in production). Publishable keys are
# designed to be public. Do NOT paste the secret key (sk_...) here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
